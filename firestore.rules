rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    /* ---------------------------------------------------------------- *
     * Default Deny
     * ---------------------------------------------------------------- */
    match /{document=**} {
      allow read, write: if false;
    }

    /* ---------------------------------------------------------------- *
     * Reusable Helpers
     * ---------------------------------------------------------------- */
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isDeveloper() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.email is string && (
          request.auth.token.email.lower() == 'qaessafty@gmail.com' ||
          request.auth.token.email.lower() == 'qayssafty@gmail.com'
        ))
      );
    }

    function isOwnerOf(targetUid) {
      return isSignedIn() && uid() == targetUid;
    }

    /* ---------------------------------------------------------------- *
     * Validation Blueprints
     * ---------------------------------------------------------------- */

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'elo', 'respectPoints'])
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && (data.get('username', '') is string && data.get('username', '').size() <= 50)
        && (data.get('email', '') is string && data.get('email', '').size() <= 200)
        && data.elo is number
        && data.respectPoints is number;
    }

    function isValidOnlineMatch(data) {
      return data.keys().hasAll(['id', 'fen', 'status', 'turn'])
        && data.id is string && data.id.size() <= 128
        && data.fen is string && data.fen.size() <= 200
        && data.status in ['waiting', 'in_progress', 'completed', 'aborted', 'checkmate', 'resigned', 'draw', 'timeout', 'abandoned']
        && data.turn in ['w', 'b'];
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll(['id', 'chatId', 'senderId', 'text'])
        && data.id is string && data.id.size() <= 128
        && data.chatId is string && data.chatId.size() <= 256
        && data.senderId is string && data.senderId.size() <= 128
        && data.text is string && data.text.size() <= 2000;
    }

    /* ---------------------------------------------------------------- *
     * Collections
     * ---------------------------------------------------------------- */

    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isOwnerOf(userId) && isValidUserProfile(incoming());
      allow update: if (isOwnerOf(userId) || isDeveloper()) 
        && isValidUserProfile(incoming())
        && incoming().uid == userId;

      match /friends/{friendId} {
        allow read: if isOwnerOf(userId) || isOwnerOf(friendId) || isDeveloper();
        allow write: if isOwnerOf(userId) || isDeveloper();
      }

      match /notifications/{notificationId} {
        allow read: if isOwnerOf(userId) || isDeveloper();
        allow create: if isSignedIn() && incoming().userId == userId;
        allow update: if (isOwnerOf(userId) || isDeveloper()) 
          && incoming().diff(existing()).affectedKeys().hasAny(['isRead', 'status']);
        allow delete: if isOwnerOf(userId) || isDeveloper();
      }

      match /blocked/{blockedId} {
        allow read, write: if isOwnerOf(userId) || isDeveloper();
      }
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.fromUserId == uid() || resource.data.toUserId == uid() || isDeveloper());
      allow create: if isSignedIn() && incoming().fromUserId == uid();
      allow update: if isSignedIn() && (existing().toUserId == uid() || existing().fromUserId == uid());
      allow delete: if isSignedIn() && (existing().toUserId == uid() || existing().fromUserId == uid());
    }

    match /online_matches/{matchId} {
      function isPlayer() {
        let whiteId = resource.data.get(['whitePlayer', 'uid'], '');
        let blackId = resource.data.get(['blackPlayer', 'uid'], '');
        let guestId = resource.data.get('guestId', '');
        return isOwnerOf(whiteId) || isOwnerOf(blackId) || isOwnerOf(guestId) || isOwnerOf(resource.data.hostId);
      }

      function isNewPlayer() {
        let whiteId = incoming().get(['whitePlayer', 'uid'], '');
        let blackId = incoming().get(['blackPlayer', 'uid'], '');
        return isOwnerOf(whiteId) || isOwnerOf(blackId) || isOwnerOf(incoming().hostId);
      }

      allow read: if true;
      allow create: if isNewPlayer() && isValidOnlineMatch(incoming());
      allow update: if (isPlayer() || isDeveloper()) && isValidOnlineMatch(incoming());
      allow delete: if isDeveloper();

      match /chat/{messageId} {
        allow read: if true;
        allow create: if isSignedIn() && isOwnerOf(incoming().senderUid);
      }

      match /typing/{typingUserId} {
        allow read: if true;
        allow write: if isOwnerOf(typingUserId);
      }
    }

    match /direct_messages/{chatId} {
      function inChat() {
        return isSignedIn() && chatId.split('_').hasAny([uid()]);
      }
      allow read: if inChat() || isDeveloper();
      allow write: if inChat() || isDeveloper();

      match /messages/{messageId} {
        allow read: if inChat() || isDeveloper();
        allow create: if inChat() && isOwnerOf(incoming().senderId) && isValidDirectMessage(incoming());
      }
    }

    match /matchmaking_queue/{ticketId} {
      allow read, list: if true;
      allow create: if isOwnerOf(incoming().player.uid) && incoming().status == 'waiting';
      allow update: if isOwnerOf(existing().player.uid) || (existing().status == 'waiting' && incoming().status == 'matched');
      allow delete: if isOwnerOf(existing().player.uid) || isDeveloper();
    }

    match /authored_puzzles/{puzzleId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwnerOf(existing().authorUid) || isDeveloper();
      allow delete: if isOwnerOf(existing().authorUid) || isDeveloper();
    }

    match /game_logs/{logId} {
      allow read: if isOwnerOf(resource.data.userId) || isDeveloper();
      allow create: if isOwnerOf(incoming().userId);
      allow update: if isDeveloper();
      allow delete: if isOwnerOf(resource.data.userId) || isDeveloper();
    }

    match /feedbacks/{feedbackId} {
      allow create: if true;
      allow read: if isDeveloper() || (isSignedIn() && resource.data.userId == uid());
      allow update, delete: if isDeveloper();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    match /system_health/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /system_configs/{configId} {
      // Allow everyone to read essential public configurations
      allow read: if configId in ['aboutUs', 'stickers'] || isDeveloper();
      // Only developers can write system configurations
      allow write: if isDeveloper();
    }
  }
}
